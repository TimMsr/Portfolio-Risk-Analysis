#!/bin/sh
# Block the commit if any public file contains private information.
# Enable once per clone with:  git config core.hooksPath hooks
PY=python3
[ -x .venv/bin/python ] && PY=.venv/bin/python
"$PY" check_public_outputs.py || {
  echo "pre-commit: privacy check failed - commit aborted."
  exit 1
}
